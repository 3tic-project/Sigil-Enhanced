<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>Live Transaction Lab</name>
  <author>Sigil Enhanced</author>
  <description>Exercises every staged transaction operation with disposable probes.</description>
  <type>edit</type>
  <engine>python3</engine>
  <version>2.0.0</version>
  <api version="2" interface="live" />
  <lifetime>command</lifetime>
  <permissions>
    <permission>book.read</permission>
    <permission>book.write.text</permission>
    <permission>book.write.binary</permission>
    <permission>book.structure</permission>
    <permission>ui.message</permission>
    <permission>ui.progress</permission>
  </permissions>
</plugin>
