set(OPENCC_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
set(ENABLE_GTEST OFF CACHE BOOL "" FORCE)
set(ENABLE_BENCHMARK OFF CACHE BOOL "" FORCE)
set(ENABLE_DARTS OFF CACHE BOOL "" FORCE)
set(BUILD_OPENCC_JIEBA_PLUGIN OFF CACHE BOOL "" FORCE)
set(BUILD_PYTHON OFF CACHE BOOL "" FORCE)

set(SIGIL_OPENCC_BINARY_DIR "${CMAKE_BINARY_DIR}/3rdparty/opencc")
set(SIGIL_OPENCC_DATA_DIR "${SIGIL_OPENCC_BINARY_DIR}/data")

add_subdirectory(
    "${CMAKE_CURRENT_SOURCE_DIR}/opencc"
    "${SIGIL_OPENCC_BINARY_DIR}"
    EXCLUDE_FROM_ALL
)

file(GLOB SIGIL_OPENCC_CONFIG_FILES
    "${CMAKE_CURRENT_SOURCE_DIR}/opencc/data/config/*.json"
)
file(GLOB SIGIL_OPENCC_DICTIONARY_FILES
    "${CMAKE_CURRENT_SOURCE_DIR}/opencc/data/dictionary/*.ocd2"
)

add_custom_command(
    OUTPUT "${SIGIL_OPENCC_DATA_DIR}/sigil-opencc-data.stamp"
    COMMAND ${CMAKE_COMMAND} -E make_directory "${SIGIL_OPENCC_DATA_DIR}"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
        ${SIGIL_OPENCC_CONFIG_FILES}
        "${SIGIL_OPENCC_DATA_DIR}"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
        ${SIGIL_OPENCC_DICTIONARY_FILES}
        "${SIGIL_OPENCC_DATA_DIR}"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
        "${CMAKE_CURRENT_SOURCE_DIR}/opencc/LICENSE"
        "${SIGIL_OPENCC_DATA_DIR}/LICENSE"
    COMMAND ${CMAKE_COMMAND} -E touch
        "${SIGIL_OPENCC_DATA_DIR}/sigil-opencc-data.stamp"
    DEPENDS ${SIGIL_OPENCC_CONFIG_FILES} ${SIGIL_OPENCC_DICTIONARY_FILES}
            "${CMAKE_CURRENT_SOURCE_DIR}/opencc/LICENSE"
    VERBATIM
)

add_custom_target(sigil_opencc_data ALL
    DEPENDS "${SIGIL_OPENCC_DATA_DIR}/sigil-opencc-data.stamp"
)

set(SIGIL_OPENCC_DATA_DIR "${SIGIL_OPENCC_DATA_DIR}" PARENT_SCOPE)
