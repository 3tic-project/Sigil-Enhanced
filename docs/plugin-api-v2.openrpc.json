{
  "openrpc": "1.3.2",
  "info": {
    "title": "Sigil Live Python Plugin API",
    "version": "2.0.0",
    "description": "Implemented protocol version 1. Each message is a four-byte big-endian length followed by one UTF-8 JSON-RPC 2.0 object. Editor offsets use UTF-16 code units."
  },
  "methods": [
    {
      "name": "session.hello",
      "summary": "Authenticate and negotiate a live plugin session.",
      "paramStructure": "by-name",
      "params": [
        { "name": "token", "required": true, "schema": { "type": "string" } },
        { "name": "protocol_version", "required": true, "schema": { "type": "integer", "const": 1 } },
        { "name": "api_version", "required": true, "schema": { "type": "integer", "const": 2 } },
        { "name": "plugin_name", "required": true, "schema": { "type": "string" } },
        { "name": "client", "schema": { "type": "object" } },
        { "name": "capabilities", "schema": { "type": "object" } }
      ],
      "result": { "name": "session", "schema": { "$ref": "#/components/schemas/SessionInfo" } }
    },
    {
      "name": "session.ping",
      "summary": "Check that the host session is responsive.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["pong"], "properties": { "pong": { "type": "boolean", "const": true } } } }
    },
    {
      "name": "session.getInfo",
      "summary": "Return the session ID, plugin name, and lifetime.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "session.finish",
      "summary": "Report command completion and close the session.",
      "paramStructure": "by-name",
      "params": [
        { "name": "status", "schema": { "type": "string", "enum": ["success", "failed"] } },
        { "name": "message", "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "events.subscribe",
      "summary": "Subscribe this session to supported editor and Book notifications.",
      "paramStructure": "by-name",
      "params": [{ "name": "events", "required": true, "schema": {
        "type": "array", "uniqueItems": true,
        "items": { "type": "string", "enum": ["editor.activeChanged", "editor.selectionChanged", "editor.cursorChanged", "editor.contentChanged", "book.resourceChanged", "book.resourceAdded", "book.resourceRemoved"] }
      } }],
      "result": { "name": "result", "schema": { "type": "object", "required": ["subscribed"], "properties": { "subscribed": { "type": "array", "items": { "type": "string" } } } } }
    },
    {
      "name": "events.unsubscribe",
      "summary": "Remove editor and Book event subscriptions from this session.",
      "paramStructure": "by-name",
      "params": [{ "name": "events", "required": true, "schema": {
        "type": "array", "uniqueItems": true,
        "items": { "type": "string", "enum": ["editor.activeChanged", "editor.selectionChanged", "editor.cursorChanged", "editor.contentChanged", "book.resourceChanged", "book.resourceAdded", "book.resourceRemoved"] }
      } }],
      "result": { "name": "result", "schema": { "type": "object", "required": ["subscribed"], "properties": { "subscribed": { "type": "array", "items": { "type": "string" } } } } }
    },
    {
      "name": "book.getInfo",
      "summary": "Return current in-memory Book metadata and revision.",
      "params": [],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/BookInfo" } }
    },
    {
      "name": "book.getMetadata",
      "summary": "Return ordered package metadata with attributes and the metadata XML fragment.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["items", "xml", "package"], "properties": {
        "items": { "type": "array", "items": { "type": "object" } },
        "xml": { "type": "string" },
        "package": { "type": "object" }
      } } }
    },
    {
      "name": "book.getManifest",
      "summary": "Return the ordered OPF manifest with resolved Book paths and resource IDs.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "type": "object" } } } } }
    },
    {
      "name": "book.getSpine",
      "summary": "Return ordered spine entries and spine element attributes.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["items", "attributes"], "properties": {
        "items": { "type": "array", "items": { "type": "object" } },
        "attributes": { "type": "object" }
      } } }
    },
    {
      "name": "book.getGuide",
      "summary": "Return EPUB 2 guide references with resolved Book paths and fragments.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "type": "object" } } } } }
    },
    {
      "name": "book.getBindings",
      "summary": "Return EPUB 3 media type handler bindings.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "type": "object" } } } } }
    },
    {
      "name": "book.getSelection",
      "summary": "Return resources currently selected in the Book Browser.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Resource" } } } } }
    },
    {
      "name": "book.getCompatibilitySnapshot",
      "summary": "Return the immutable startup state required by the legacy container adapter.",
      "params": [],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/CompatibilitySnapshot" } }
    },
    {
      "name": "book.getRevision",
      "summary": "Return the current session-local Book revision.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["revision"], "properties": { "revision": { "$ref": "#/components/schemas/Revision" } } } }
    },
    {
      "name": "validation.publishResults",
      "summary": "Replace Sigil's Validation Results view with structured plugin findings.",
      "paramStructure": "by-name",
      "params": [
        { "name": "results", "required": true, "schema": {
          "type": "array", "maxItems": 10000,
          "items": { "$ref": "#/components/schemas/ValidationResult" }
        } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["accepted"], "properties": { "accepted": { "type": "integer", "minimum": 0 } } } }
    },
    {
      "name": "archive.listFiles",
      "summary": "List every regular file in the expanded EPUB, including untracked infrastructure files.",
      "paramStructure": "by-name",
      "params": [
        { "name": "page_size", "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 200 } },
        { "name": "cursor", "schema": { "type": ["string", "null"] } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/ArchiveFilePage" } }
    },
    {
      "name": "archive.readFile",
      "summary": "Read an expanded EPUB file up to 5 MiB with its SHA-256 concurrency token.",
      "paramStructure": "by-name",
      "params": [{ "name": "book_path", "required": true, "schema": { "type": "string" } }],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/ArchiveFileContent" } }
    },
    {
      "name": "resource.list",
      "summary": "List resources with type filtering and offset cursor pagination.",
      "paramStructure": "by-name",
      "params": [
        { "name": "types", "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "page_size", "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 200 } },
        { "name": "cursor", "schema": { "type": ["string", "null"] } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/ResourcePage" } }
    },
    {
      "name": "resource.resolvePath",
      "summary": "Resolve a current canonical Book path.",
      "paramStructure": "by-name",
      "params": [{ "name": "book_path", "required": true, "schema": { "type": "string" } }],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/Resource" } }
    },
    {
      "name": "resource.getInfo",
      "summary": "Return metadata for one session resource ID.",
      "paramStructure": "by-name",
      "params": [{ "name": "resource_id", "required": true, "schema": { "type": "string" } }],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/Resource" } }
    },
    {
      "name": "resource.readText",
      "summary": "Read current in-memory text without writing the Book to disk.",
      "paramStructure": "by-name",
      "params": [{ "name": "resource_id", "required": true, "schema": { "type": "string" } }],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/TextContent" } }
    },
    {
      "name": "resource.readBinary",
      "summary": "Read a binary resource up to 5 MiB as base64 without snapshotting the Book.",
      "paramStructure": "by-name",
      "params": [{ "name": "resource_id", "required": true, "schema": { "type": "string" } }],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/BinaryContent" } }
    },
    {
      "name": "resource.readMany",
      "summary": "Read at most 100 current text resources.",
      "paramStructure": "by-name",
      "params": [{ "name": "resource_ids", "required": true, "schema": { "type": "array", "maxItems": 100, "items": { "type": "string" } } }],
      "result": { "name": "result", "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "allOf": [{ "$ref": "#/components/schemas/TextContent" }, { "type": "object", "required": ["resource_id"], "properties": { "resource_id": { "type": "string" } } }] } } } } }
    },
    {
      "name": "binary.openRead",
      "summary": "Create a stable session-owned snapshot of a resource or expanded EPUB file.",
      "paramStructure": "by-name",
      "params": [
        { "name": "resource_id", "schema": { "type": "string" } },
        { "name": "book_path", "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["stream_id", "resource_id", "book_path", "revision", "size", "sha256", "chunk_size"], "properties": {
        "stream_id": { "type": "string", "format": "uuid" },
        "resource_id": { "type": ["string", "null"] },
        "book_path": { "type": "string" },
        "revision": { "oneOf": [{ "$ref": "#/components/schemas/Revision" }, { "type": "null" }] },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "chunk_size": { "type": "integer", "minimum": 1, "maximum": 2097152 }
      } } }
    },
    {
      "name": "binary.readChunk",
      "summary": "Read the next base64-encoded chunk from a binary snapshot.",
      "paramStructure": "by-name",
      "params": [
        { "name": "stream_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "max_bytes", "schema": { "type": "integer", "minimum": 1, "maximum": 2097152, "default": 1048576 } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["stream_id", "data_base64", "offset", "eof"], "properties": {
        "stream_id": { "type": "string", "format": "uuid" },
        "data_base64": { "type": "string", "contentEncoding": "base64" },
        "offset": { "type": "integer", "minimum": 0 },
        "eof": { "type": "boolean" }
      } } }
    },
    {
      "name": "binary.close",
      "summary": "Close and remove a session-owned binary snapshot.",
      "paramStructure": "by-name",
      "params": [{ "name": "stream_id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "result": { "name": "result", "schema": { "type": "object", "required": ["closed"], "properties": { "closed": { "type": "boolean", "const": true } } } }
    },
    {
      "name": "input.beginEpub",
      "summary": "Begin a bounded, session-private EPUB upload for an input plugin.",
      "paramStructure": "by-name",
      "params": [
        { "name": "filename", "required": true, "schema": { "type": "string", "pattern": "^[^/\\\\]+\\.[eE][pP][uU][bB]$" } },
        { "name": "size", "schema": { "type": "integer", "minimum": 0, "maximum": 2147483648 } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["upload_id", "chunk_size", "max_size"], "properties": {
        "upload_id": { "type": "string", "format": "uuid" },
        "chunk_size": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "max_size": { "type": "integer", "const": 2147483648 }
      } } }
    },
    {
      "name": "input.writeChunk",
      "summary": "Append one base64-encoded chunk to an input EPUB upload.",
      "paramStructure": "by-name",
      "params": [
        { "name": "upload_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "data_base64", "required": true, "schema": { "type": "string", "contentEncoding": "base64" } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["upload_id", "received"], "properties": {
        "upload_id": { "type": "string", "format": "uuid" },
        "received": { "type": "integer", "minimum": 1, "maximum": 2147483648 }
      } } }
    },
    {
      "name": "input.finishEpub",
      "summary": "Verify and submit a completed EPUB upload for replacement after plugin success.",
      "paramStructure": "by-name",
      "params": [
        { "name": "upload_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "sha256", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["accepted", "filename", "size", "sha256"], "properties": {
        "accepted": { "type": "boolean", "const": true },
        "filename": { "type": "string" },
        "size": { "type": "integer", "minimum": 4, "maximum": 2147483648 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      } } }
    },
    {
      "name": "output.exportEpub",
      "summary": "Save to the current source EPUB when path is omitted, or export a copy to an absolute EPUB path.",
      "paramStructure": "by-name",
      "params": [{ "name": "path", "schema": { "type": "string" } }],
      "result": { "name": "result", "schema": { "type": "object", "required": ["exported", "path", "mode"], "properties": {
        "exported": { "type": "boolean" },
        "path": { "type": "string" },
        "mode": { "type": "string", "enum": ["source", "copy"] }
      } } }
    },
    {
      "name": "editor.getState",
      "summary": "Return active editor resource, revision, cursor, and selection.",
      "params": [],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditorState" } }
    },
    {
      "name": "editor.getSelection",
      "summary": "Return the current editor state including selected text.",
      "params": [],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditorState" } }
    },
    {
      "name": "editor.getOpenTabs",
      "summary": "Return resources currently loaded in editor tabs.",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Resource" } } } } }
    },
    {
      "name": "editor.applyEdits",
      "summary": "Apply 1-1000 non-overlapping UTF-16 edits to the active text tab as one undo step.",
      "paramStructure": "by-name",
      "params": [
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } },
        { "name": "label", "schema": { "type": "string" } },
        { "name": "edits", "required": true, "schema": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/components/schemas/TextEdit" } } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditResult" } }
    },
    {
      "name": "editor.replaceSelection",
      "summary": "Replace the active editor selection as one undo step.",
      "paramStructure": "by-name",
      "params": [
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } },
        { "name": "text", "required": true, "schema": { "type": "string" } },
        { "name": "label", "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditResult" } }
    },
    {
      "name": "editor.insertText",
      "summary": "Insert text at the active editor cursor as one undo step.",
      "paramStructure": "by-name",
      "params": [
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } },
        { "name": "text", "required": true, "schema": { "type": "string" } },
        { "name": "label", "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditResult" } }
    },
    {
      "name": "editor.setCursor",
      "summary": "Set the current editor cursor using a UTF-16 position.",
      "paramStructure": "by-name",
      "params": [
        { "name": "resource_id", "schema": { "type": "string" } },
        { "name": "position", "required": true, "schema": { "$ref": "#/components/schemas/Position" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditorState" } }
    },
    {
      "name": "editor.setSelection",
      "summary": "Set the current editor selection using UTF-16 positions.",
      "paramStructure": "by-name",
      "params": [
        { "name": "resource_id", "schema": { "type": "string" } },
        { "name": "start", "required": true, "schema": { "$ref": "#/components/schemas/Position" } },
        { "name": "end", "required": true, "schema": { "$ref": "#/components/schemas/Position" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditorState" } }
    },
    {
      "name": "editor.openResource",
      "summary": "Open or activate a resource and optionally reveal a UTF-16 position.",
      "paramStructure": "by-name",
      "params": [
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "position", "schema": { "$ref": "#/components/schemas/Position" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditorState" } }
    },
    {
      "name": "editor.revealRange",
      "summary": "Open a resource and select a UTF-16 range.",
      "paramStructure": "by-name",
      "params": [
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "start", "required": true, "schema": { "$ref": "#/components/schemas/Position" } },
        { "name": "end", "required": true, "schema": { "$ref": "#/components/schemas/Position" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/EditorState" } }
    },
    {
      "name": "ui.showStatus",
      "summary": "Show a bounded message in Sigil's status bar.",
      "paramStructure": "by-name",
      "params": [
        { "name": "message", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        { "name": "duration_ms", "schema": { "type": "integer", "minimum": 0, "maximum": 60000, "default": 5000 } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["shown"], "properties": { "shown": { "type": "boolean" } } } }
    },
    {
      "name": "ui.showMessage",
      "summary": "Show a modal informational, warning, or error message.",
      "paramStructure": "by-name",
      "params": [
        { "name": "message", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 65536 } },
        { "name": "title", "schema": { "type": "string", "maxLength": 256 } },
        { "name": "level", "schema": { "type": "string", "enum": ["info", "warning", "error"], "default": "info" } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["shown"], "properties": { "shown": { "type": "boolean" } } } }
    },
    {
      "name": "ui.confirm",
      "summary": "Ask the user a yes/no question with No as the safe default.",
      "paramStructure": "by-name",
      "params": [
        { "name": "message", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 65536 } },
        { "name": "title", "schema": { "type": "string", "maxLength": 256 } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["confirmed"], "properties": { "confirmed": { "type": "boolean" } } } }
    },
    {
      "name": "ui.progressBegin",
      "summary": "Begin one determinate or indeterminate progress operation in the session console.",
      "paramStructure": "by-name",
      "params": [
        { "name": "label", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        { "name": "total", "schema": { "type": "integer", "minimum": 0, "maximum": 1000000000, "default": 0 } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["progress_id", "total"], "properties": {
        "progress_id": { "type": "string", "format": "uuid" },
        "total": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      } } }
    },
    {
      "name": "ui.chooseOpenFile",
      "summary": "Ask the user to select one readable file and return its local path.",
      "paramStructure": "by-name",
      "params": [
        { "name": "title", "schema": { "type": "string", "maxLength": 256 } },
        { "name": "filter", "schema": { "type": "string", "maxLength": 2048 } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["path"], "properties": { "path": { "type": ["string", "null"] } } } }
    },
    {
      "name": "ui.chooseSaveFile",
      "summary": "Ask the user to select one output file and return its local path.",
      "paramStructure": "by-name",
      "params": [
        { "name": "suggested_name", "schema": { "type": "string", "maxLength": 255 } },
        { "name": "title", "schema": { "type": "string", "maxLength": 256 } },
        { "name": "filter", "schema": { "type": "string", "maxLength": 2048 } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["path"], "properties": { "path": { "type": ["string", "null"] } } } }
    },
    {
      "name": "ui.progressUpdate",
      "summary": "Update the active progress value and optional label.",
      "paramStructure": "by-name",
      "params": [
        { "name": "progress_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "value", "required": true, "schema": { "type": "integer", "minimum": 0, "maximum": 1000000000 } },
        { "name": "label", "schema": { "type": "string", "maxLength": 1024 } }
      ],
      "result": { "name": "result", "schema": { "type": "object", "required": ["updated"], "properties": { "updated": { "type": "boolean", "const": true } } } }
    },
    {
      "name": "ui.progressEnd",
      "summary": "End and hide the active progress operation.",
      "paramStructure": "by-name",
      "params": [{ "name": "progress_id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "result": { "name": "result", "schema": { "type": "object", "required": ["ended"], "properties": { "ended": { "type": "boolean", "const": true } } } }
    },
    {
      "name": "transaction.begin",
      "summary": "Begin the session's single staged text transaction.",
      "paramStructure": "by-name",
      "params": [
        { "name": "label", "schema": { "type": "string" } },
        { "name": "visibility", "schema": { "type": "string", "const": "staged", "default": "staged" } },
        { "name": "checkpoint", "schema": { "type": "string", "enum": ["none", "auto", "required"], "default": "auto" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/TransactionInfo" } }
    },
    {
      "name": "transaction.readText",
      "summary": "Read staged content when present, otherwise current live content.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "resource_id", "required": true, "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "allOf": [{ "$ref": "#/components/schemas/TextContent" }, { "type": "object", "properties": { "resource_id": { "type": "string" }, "staged": { "type": "boolean" } } }] } }
    },
    {
      "name": "transaction.readBinary",
      "summary": "Read staged binary data when present, otherwise current resource data.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "resource_id", "required": true, "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "allOf": [{ "$ref": "#/components/schemas/BinaryContent" }, { "type": "object", "properties": { "staged": { "type": "boolean" } } }] } }
    },
    {
      "name": "transaction.writeBinary",
      "summary": "Stage a complete binary replacement up to 5 MiB.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } },
        { "name": "data_base64", "required": true, "schema": { "type": "string", "contentEncoding": "base64" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.addResource",
      "summary": "Stage a manifested or unmanifested text/binary resource addition.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "book_path", "required": true, "schema": { "type": "string" } },
        { "name": "media_type", "required": true, "schema": { "type": "string" } },
        { "name": "manifest_id", "schema": { "type": ["string", "null"] } },
        { "name": "text", "schema": { "type": "string" } },
        { "name": "data_base64", "schema": { "type": "string", "contentEncoding": "base64" } },
        { "name": "properties", "schema": { "type": ["string", "null"] } },
        { "name": "fallback", "schema": { "type": ["string", "null"] } },
        { "name": "overlay", "schema": { "type": ["string", "null"] } },
        { "name": "add_to_spine", "schema": { "type": "boolean", "default": true } },
        { "name": "manifested", "schema": { "type": "boolean", "default": true } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.replaceArchiveFile",
      "summary": "Stage replacement of an existing untracked EPUB file by SHA-256 token.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "book_path", "required": true, "schema": { "type": "string" } },
        { "name": "expected_sha256", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        { "name": "text", "schema": { "type": "string" } },
        { "name": "data_base64", "schema": { "type": "string", "contentEncoding": "base64" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.removeArchiveFile",
      "summary": "Stage removal of an existing untracked EPUB file by SHA-256 token.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "book_path", "required": true, "schema": { "type": "string" } },
        { "name": "expected_sha256", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.removeResource",
      "summary": "Stage removal of an existing resource.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.moveResource",
      "summary": "Stage relocation to a canonical unoccupied Book path.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "book_path", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.renameResource",
      "summary": "Stage a filename change in the current resource folder.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "filename", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.replaceText",
      "summary": "Stage a complete text replacement without changing the Book.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } },
        { "name": "text", "required": true, "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.replacePackage",
      "summary": "Stage one authoritative, validated OPF package replacement.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } },
        { "name": "text", "required": true, "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.applyTextEdits",
      "summary": "Compose UTF-16 patches against the transaction's staged text.",
      "paramStructure": "by-name",
      "params": [
        { "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "resource_id", "required": true, "schema": { "type": "string" } },
        { "name": "expected_revision", "required": true, "schema": { "$ref": "#/components/schemas/Revision" } },
        { "name": "edits", "required": true, "schema": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/components/schemas/TextEdit" } } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.validate",
      "summary": "Report revision conflicts without applying staged changes.",
      "paramStructure": "by-name",
      "params": [{ "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/TransactionValidation" } }
    },
    {
      "name": "transaction.preview",
      "summary": "Return staged change counts, lengths, conflicts, and warnings.",
      "paramStructure": "by-name",
      "params": [{ "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/TransactionValidation" } }
    },
    {
      "name": "transaction.commit",
      "summary": "Revalidate, optionally create one Checkpoint, and apply once per changed resource.",
      "paramStructure": "by-name",
      "params": [{ "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "transaction.rollback",
      "summary": "Discard all staged changes without changing the Book.",
      "paramStructure": "by-name",
      "params": [{ "name": "transaction_id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "result": { "name": "result", "schema": { "type": "object" } }
    }
  ],
  "components": {
    "schemas": {
      "Revision": { "type": "integer", "minimum": 0 },
      "Position": { "type": "integer", "minimum": 0 },
      "SessionInfo": {
        "type": "object",
        "required": ["session_id", "protocol_version", "api_version", "lifetime", "position_encoding", "max_message_size"],
        "properties": {
          "session_id": { "type": "string", "format": "uuid" },
          "protocol_version": { "type": "integer", "const": 1 },
          "api_version": { "type": "integer", "const": 2 },
          "lifetime": { "type": "string", "enum": ["command", "book-session"] },
          "position_encoding": { "type": "string", "const": "utf-16" },
          "max_message_size": { "type": "integer", "minimum": 1, "maximum": 33554432 },
          "book_revision": { "$ref": "#/components/schemas/Revision" },
          "ui": { "type": "object" }
        }
      },
      "BookInfo": {
        "type": "object",
        "required": ["epub_version", "modified", "file_path", "revision"],
        "properties": {
          "epub_version": { "type": "string" },
          "modified": { "type": "boolean" },
          "file_path": { "type": "string" },
          "revision": { "$ref": "#/components/schemas/Revision" }
        }
      },
      "CompatibilitySnapshot": {
        "type": "object",
        "required": ["package", "resources", "selected", "font_mangling", "configuration"],
        "properties": {
          "package": {
            "type": "object",
            "required": ["resource", "text", "book_path"],
            "properties": {
              "resource": { "$ref": "#/components/schemas/Resource" },
              "text": { "type": "string" },
              "book_path": { "type": "string" }
            }
          },
          "resources": { "type": "array", "items": { "$ref": "#/components/schemas/Resource" } },
          "selected": { "type": "array", "items": { "type": "string" } },
          "font_mangling": { "type": "object", "additionalProperties": { "type": "string" } },
          "configuration": {
            "type": "object",
            "required": ["application_dir", "preferences_dir", "linux_hunspell_dictionary_dirs", "ui_language", "spellcheck_language", "color_mode", "colors", "ui_font", "using_automate", "automate_parameter"],
            "properties": {
              "application_dir": { "type": "string" },
              "preferences_dir": { "type": "string" },
              "linux_hunspell_dictionary_dirs": { "type": "array", "items": { "type": "string" } },
              "ui_language": { "type": "string" },
              "spellcheck_language": { "type": "string" },
              "color_mode": { "type": "string", "enum": ["light", "dark"] },
              "colors": { "type": "object", "additionalProperties": { "type": "string" } },
              "ui_font": { "type": "string" },
              "using_automate": { "type": "boolean" },
              "automate_parameter": { "type": "string" }
            }
          }
        }
      },
      "Resource": {
        "type": "object",
        "required": ["resource_id", "book_path", "media_type", "resource_type", "content_revision", "loaded"],
        "properties": {
          "resource_id": { "type": "string" },
          "book_path": { "type": "string" },
          "media_type": { "type": "string" },
          "resource_type": { "type": "string" },
          "content_revision": { "$ref": "#/components/schemas/Revision" },
          "loaded": { "type": "boolean" }
        }
      },
      "ResourcePage": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Resource" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "ArchiveFile": {
        "type": "object",
        "required": ["book_path", "size", "resource_id", "protected"],
        "properties": {
          "book_path": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "resource_id": { "type": ["string", "null"] },
          "protected": { "type": "boolean" }
        }
      },
      "ArchiveFilePage": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ArchiveFile" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "ArchiveFileContent": {
        "type": "object",
        "required": ["book_path", "data_base64", "sha256", "protected"],
        "properties": {
          "book_path": { "type": "string" },
          "data_base64": { "type": "string", "contentEncoding": "base64" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "protected": { "type": "boolean" }
        }
      },
      "ValidationResult": {
        "type": "object",
        "required": ["type", "book_path", "line", "character", "message"],
        "properties": {
          "type": { "type": "string", "enum": ["info", "warning", "error"] },
          "book_path": { "type": "string" },
          "line": { "type": "integer", "minimum": -1 },
          "character": { "type": "integer", "minimum": -1 },
          "message": { "type": "string", "minLength": 1, "maxLength": 65536 }
        }
      },
      "TextContent": {
        "type": "object",
        "required": ["text", "revision"],
        "properties": {
          "text": { "type": "string" },
          "revision": { "$ref": "#/components/schemas/Revision" }
        }
      },
      "BinaryContent": {
        "type": "object",
        "required": ["resource_id", "data_base64", "revision"],
        "properties": {
          "resource_id": { "type": "string" },
          "data_base64": { "type": "string", "contentEncoding": "base64" },
          "revision": { "$ref": "#/components/schemas/Revision" }
        }
      },
      "Selection": {
        "type": "object",
        "required": ["start", "end", "text"],
        "properties": {
          "start": { "$ref": "#/components/schemas/Position" },
          "end": { "$ref": "#/components/schemas/Position" },
          "text": { "type": "string" }
        }
      },
      "EditorState": {
        "type": "object",
        "required": ["active"],
        "properties": {
          "active": { "type": "boolean" },
          "resource_id": { "type": "string" },
          "book_path": { "type": "string" },
          "revision": { "$ref": "#/components/schemas/Revision" },
          "cursor": { "$ref": "#/components/schemas/Position" },
          "selection": { "$ref": "#/components/schemas/Selection" },
          "position_encoding": { "type": "string", "const": "utf-16" }
        }
      },
      "TextEdit": {
        "type": "object",
        "required": ["start", "end", "text"],
        "properties": {
          "start": { "$ref": "#/components/schemas/Position" },
          "end": { "$ref": "#/components/schemas/Position" },
          "text": { "type": "string" }
        }
      },
      "EditResult": {
        "type": "object",
        "required": ["resource_id", "revision", "applied_edits"],
        "properties": {
          "resource_id": { "type": "string" },
          "revision": { "$ref": "#/components/schemas/Revision" },
          "applied_edits": { "type": "integer", "minimum": 1 }
        }
      },
      "TransactionInfo": {
        "type": "object",
        "required": ["transaction_id", "base_book_revision", "visibility", "checkpoint"],
        "properties": {
          "transaction_id": { "type": "string", "format": "uuid" },
          "base_book_revision": { "$ref": "#/components/schemas/Revision" },
          "visibility": { "type": "string", "const": "staged" },
          "checkpoint": { "type": "string", "enum": ["none", "auto", "required"] }
        }
      },
      "TransactionValidation": {
        "type": "object",
        "required": ["transaction_id", "valid", "conflicts", "summary"],
        "properties": {
          "transaction_id": { "type": "string", "format": "uuid" },
          "valid": { "type": "boolean" },
          "conflicts": { "type": "array", "items": { "type": "object" } },
          "summary": { "type": "object" }
        }
      }
    },
    "errors": {
      "BookClosed": { "code": -32002, "message": "Book closed" },
      "ResourceNotFound": { "code": -32003, "message": "Resource not found" },
      "RevisionConflict": { "code": -32004, "message": "Revision conflict" },
      "InvalidPatch": { "code": -32005, "message": "Invalid patch" },
      "TransactionRequired": { "code": -32006, "message": "Transaction required" },
      "ValidationFailed": { "code": -32007, "message": "Validation failed" },
      "PayloadTooLarge": { "code": -32008, "message": "Payload too large" },
      "Busy": { "code": -32009, "message": "Busy" },
      "UnsupportedOperation": { "code": -32010, "message": "Unsupported operation" },
      "TransactionNotFound": { "code": -32011, "message": "Transaction not found" },
      "SessionEnding": { "code": -32012, "message": "Session ending" }
    }
  }
}
